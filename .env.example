# ====================================================
# OUR SMP Control Center - Environment Variables
# ====================================================

# Backend Server Port
PORT=5001

# Optional: MongoDB Atlas Connection URI
# Leave blank to use built-in high-performance memory storage mode
MONGODB_URI=

# JWT and Bot Communication Secrets
JWT_SECRET=our-smp-super-secret-jwt-key-2026
BOT_AGENT_SECRET=our-smp-bot-agent-secret-token

# Bedrock Server Details
BEDROCK_SERVER_HOST=ayx.acido.dev
BEDROCK_SERVER_PORT=19132
BEDROCK_TRANSPORT=nethernet
SERVER_POLL_INTERVAL_MS=5000

# AcidoHost / Pterodactyl Panel Integration
# Allows the Control Center to send server console commands (like tp IronBot 40 108 -13)
ACIDOHOST_PANEL_URL=https://panel.acido.dev
ACIDOHOST_SERVER_ID=
ACIDOHOST_API_KEY=ptlc_...

# Auto-Teleport Settings
AUTO_TELEPORT_ENABLED=true
AUTO_TELEPORT_DELAY_SEC=8
AUTO_TELEPORT_DISTANCE_THRESHOLD=10

# Optional: Discord Webhook Notifications
DISCORD_WEBHOOK_URL=
